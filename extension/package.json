{
  "name": "heb-grocery-extension",
  "version": "1.1.0",
  "description": "Chrome extension that adds a grocery list to your HEB.com cart",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
