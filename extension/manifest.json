{
  "manifest_version": 3,
  "name": "HEB Grocery Agent",
  "description": "Paste a grocery list and add every item to your HEB.com cart. Optional AI cleanup fixes typos and duplicates first.",
  "author": "Michelle Mayes",
  "homepage_url": "https://github.com/michellemayes/heb-grocery-agent",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://www.heb.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "action": {
    "default_title": "Open HEB Grocery Agent"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.heb.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
